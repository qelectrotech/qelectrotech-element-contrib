    <names>
        <name lang="en">Dyness STACK100 – krmilnik/BDU SBDU100</name>
        <name lang="sl">Dyness STACK100 – krmilnik/BDU SBDU100</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Dyness</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">Dyness STACK100 – krmilnik/BDU SBDU100</elementInformation>
        <elementInformation name="designation" show="1">Dyness STACK100 – krmilnik/BDU SBDU100</elementInformation>
        <elementInformation name="description" show="1">baterijski krmilnik; baterija [134.4, 864] V; komunikacija: 2× RJ45 Inverter CAN/RS485 (pin1 485_B, pin2 485_A, pin4 CANH, pin5 CANL), RJ45 Parallel in / Parallel out (CAN, 120 Ω na prvem in zadnjem), TCP/IP (rezervirano za nekatere razsmernike večjih moči), WiFi (aplikacija, OTA)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Dyness STACK100 Datasheet EN 20260520 (SBDU100) str. 2; STACK100 User Manual EN V7.0 str. 13–15 (tab. 2-5, 2-8), 22–24 (pakiranje), 40–44 (vezava)</elementInformation>
        <elementInformation name="mass_kg" show="1">15.3</elementInformation>
        <elementInformation name="width" show="1">590</elementInformation>
        <elementInformation name="height" show="1">133</elementInformation>
        <elementInformation name="depth" show="1">390</elementInformation>
    </elementInformations>
    <informations>Viri: Dyness STACK100 Datasheet EN 20260520 (SBDU100) str. 2; STACK100 User Manual EN V7.0 str. 13–15 (tab. 2-5, 2-8), 22–24 (pakiranje), 40–44 (vezava)
