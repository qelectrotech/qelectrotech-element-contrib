        <elementInformation name="mass_kg" show="1">8</elementInformation>
        <elementInformation name="width" show="1">765</elementInformation>
        <elementInformation name="height" show="1">109</elementInformation>
        <elementInformation name="depth" show="1">260</elementInformation>
    </elementInformations>
