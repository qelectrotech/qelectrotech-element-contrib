    <names>
        <name lang="en">SolarEdge Home Battery 48V 23 kWh (komplet)</name>
        <name lang="sl">SolarEdge Home Battery 48V 23 kWh (komplet)</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SLEBAT-05K48M0B-02 x5</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge Home Battery 48V 23 kWh (komplet)</elementInformation>
        <elementInformation name="description" show="1">baterija; baterija [44.8, 56.5] V; komunikacija: CAN bus do razsmernika (RJ45 'Inverter', samo zgornji modul), RS485 med moduli (2x RJ45 'COMM')</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Home Battery 48V for Europe BAT-05K48 - datasheet, DS-000141-EU, 17. 2. 2025 (velja za BAT-05K48M0B-01 in -02); kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. 2; SolarEdge Home Battery 48V Installation Guide, For Europe and APAC, MAN-01-00954-1.2, verzija 1.2; kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. tiskane strani (PDF stran = tiskana + 1): 7-8 (kabel 35 mm2, dodatki), 8-9 (konfiguracije stolpov), 11-12 (odmiki, mere), 13-14 (Figure 3 opis priključkov), 17 (max 3 v stolpu), 19-24 (priključitev), 27-28 (več modulov, Figure 21)</elementInformation>
        <elementInformation name="mass_kg" show="1">54.7</elementInformation>
        <elementInformation name="width" show="1">540</elementInformation>
        <elementInformation name="height" show="1">500</elementInformation>
        <elementInformation name="depth" show="1">240</elementInformation>
    </elementInformations>
    <informations>Viri: SolarEdge Home Battery 48V for Europe BAT-05K48 - datasheet, DS-000141-EU, 17. 2. 2025 (velja za BAT-05K48M0B-01 in -02); kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. 2; SolarEdge Home Battery 48V Installation Guide, For Europe and APAC, MAN-01-00954-1.2, verzija 1.2; kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. tiskane strani (PDF stran = tiskana + 1): 7-8 (kabel 35 mm2, dodatki), 8-9 (konfiguracije stolpov), 11-12 (odmiki, mere), 13-14 (Figure 3 opis priključkov), 17 (max 3 v stolpu), 19-24 (priključitev), 27-28 (več modulov, Figure 21)
