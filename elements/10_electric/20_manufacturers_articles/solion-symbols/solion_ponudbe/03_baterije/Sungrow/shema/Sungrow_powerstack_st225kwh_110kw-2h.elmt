    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sungrow</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">ST225kWh-110kW-2h</elementInformation>
        <elementInformation name="designation" show="1">Sungrow powerstack st225kwh 110kw-2h</elementInformation>
        <elementInformation name="description" show="1">baterija; baterija [691.2, 934.4] V; komunikacija: NET2 / NET3 – Ethernet (CAT6A S/FTP) med omarami in do omrežja kupca; NET1 = PCS (notranje); NET4 rezerva, CONN1 / CONN2 – sponke za suhe kontakte, EMS RS485, vzporedno PCS, FSS, Modbus TCP</elementInformation>
        <elementInformation name="notes" show="1">Viri: Sungrow ST225kWh-110kW-2h Datasheet V3 EN (APAC&amp;EUR) str. 2; ST225kWh-110kW-2h IEC User Manual Ver31 (2025-02) str. tiskane 8–17 (zgradba), 45–63 (električna vezava); PDF str. 20 (mere), 56 (vezalna shema), 68 (AC sponke), 70–72 (CONN, NET); Sungrow produktna stran B-ST225kWh-110kW-2H str. -</elementInformation>
        <elementInformation name="mass_kg" show="1">3100</elementInformation>
        <elementInformation name="width" show="1">1150</elementInformation>
        <elementInformation name="height" show="1">2450</elementInformation>
        <elementInformation name="depth" show="1">1610</elementInformation>
    </elementInformations>
