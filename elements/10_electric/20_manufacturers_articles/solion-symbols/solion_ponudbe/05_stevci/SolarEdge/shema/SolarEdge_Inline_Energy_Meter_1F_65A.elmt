<definition version="0.200" type="element" link_type="simple" width="320" height="230" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{c35b0e37-415b-5774-a40a-97198ce4b08b}" />
    <names>
        <name lang="en">SolarEdge Inline Energy Meter 1F 65A</name>
        <name lang="sl">SolarEdge Inline Energy Meter 1F 65A</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SLEMTR-240-1PC1-DW-MW</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge Inline Energy Meter 1F 65A</elementInformation>
        <elementInformation name="description" show="1">števec; komunikacija: SolarEdge Home Network / Energy Net (brezžično, 863-870 MHz EU, notranja antena; zunanja antena SE-ANT-ENET-HB-01 na SMA-RP opcija), RS485 half duplex, 3 žice (A, B, GND), Modbus RTU, privzeti Modbus ID 2, zaključitev 120 Ω izbirna v meniju števca (privzeto ON po IG)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Home Inline Meter - datasheet, DS-000001-ENG, 15. 11. 2022 (stolpec MTR-240-1PC1-DW-MW / MTR EU1); kopija uradnega SolarEdge dokumenta (vir: memodo.cz) str. 2-3 (električni podatki, RS485, brezžično, mere, masa, IP, okolje); Installation Guide - Inline Energy Meter with SolarEdge Home Network Communications, For Europe and Australia, Version 1.1 (marec 2022); kopija uradnega SolarEdge dokumenta (vir: portal.segen.co.uk) str. tiskane str. 6 (MTR-240-1PC1-DW-MW samo 1F), 15-17 (kabli, DIN, razred A/B), 21 (sl. 12: sponke 1 L, 2 N zgoraj; 3 L, 4 N spodaj), 24 (RS485 A+ B- G), 31 (RS485 Term privzeto ON); PDF stran = tiskana + 1; Inline Energy Meter Quick Installation Guide For Europe, APAC and South Africa, avgust 2021; kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. 1-2 (EN: vezava 1Ø razred A/B, 1,2 Nm, 1,5-25 mm², RS485 ID 2)</elementInformation>
        <elementInformation name="mass_kg" show="1">0.32</elementInformation>
        <elementInformation name="width" show="1">72</elementInformation>
        <elementInformation name="height" show="1">90</elementInformation>
        <elementInformation name="depth" show="1">58</elementInformation>
    </elementInformations>
    <informations>Viri: SolarEdge Home Inline Meter - datasheet, DS-000001-ENG, 15. 11. 2022 (stolpec MTR-240-1PC1-DW-MW / MTR EU1); kopija uradnega SolarEdge dokumenta (vir: memodo.cz) str. 2-3 (električni podatki, RS485, brezžično, mere, masa, IP, okolje); Installation Guide - Inline Energy Meter with SolarEdge Home Network Communications, For Europe and Australia, Version 1.1 (marec 2022); kopija uradnega SolarEdge dokumenta (vir: portal.segen.co.uk) str. tiskane str. 6 (MTR-240-1PC1-DW-MW samo 1F), 15-17 (kabli, DIN, razred A/B), 21 (sl. 12: sponke 1 L, 2 N zgoraj; 3 L, 4 N spodaj), 24 (RS485 A+ B- G), 31 (RS485 Term privzeto ON); PDF stran = tiskana + 1; Inline Energy Meter Quick Installation Guide For Europe, APAC and South Africa, avgust 2021; kopija uradnega SolarEdge dokumenta (vir: memodo.de) str. 1-2 (EN: vezava 1Ø razred A/B, 1,2 Nm, 1,5-25 mm², RS485 ID 2)
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
