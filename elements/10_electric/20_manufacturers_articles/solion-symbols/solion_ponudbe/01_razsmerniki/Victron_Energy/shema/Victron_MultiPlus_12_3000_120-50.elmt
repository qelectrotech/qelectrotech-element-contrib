    <uuid uuid="{26304810-a7a4-5977-b49e-d2e1ca85ab14}" />
    <names>
        <name lang="en">Victron MultiPlus 12/3000/120-50</name>
        <name lang="sl">Victron MultiPlus 12/3000/120-50</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus 12/3000/120-50 230V VE.Bus (PMP123021010)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus 12/3000/120-50</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (B), daljinsko stikalo, 3-polna sponka H, alarmni rele I: NC, NO, COM, sponke E (od leve): TEMP +/-, AUX1 +/-, AUX2 +/-, GND-relay +/-, STARTER+, K1 NC/NO/COM, K2 NC/NO/COM, V-SENSE +/-, 3 programabilni releji (alarm + K1 + K2) in 2 analogna/digitalna vhoda (50 A model), DIP stikala DS1-DS8, tipki Up/Down</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus 3k 230V 16A/50A manual (EN) str. 10-12 (namestitev), 25 (tehnični podatki), 145-146 (Appendix A, 50 A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus/Quattro 3000VA str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_3k_50a/multiplus_quattro_3000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">18</elementInformation>
        <elementInformation name="width" show="1">258</elementInformation>
        <elementInformation name="height" show="1">364</elementInformation>
        <elementInformation name="depth" show="1">221</elementInformation>
    </elementInformations>
    <informations>Viri: MultiPlus 3k 230V 16A/50A manual (EN) str. 10-12 (namestitev), 25 (tehnični podatki), 145-146 (Appendix A, 50 A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus/Quattro 3000VA str. 1; Victron produktna stran (SKU podatki)
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
