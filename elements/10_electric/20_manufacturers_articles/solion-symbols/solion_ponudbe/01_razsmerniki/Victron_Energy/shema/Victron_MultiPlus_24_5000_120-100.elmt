    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus 24/5000/120-100 230V VE.Bus (PMP245021010)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus 24/5000/120-100</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (B), daljinsko stikalo, 3-polna sponka H, alarmni rele I: NC, NO, COM, sponke E (od leve): V-SENSE, T-SENSE, AUX1, AUX2, GND-relay, STARTER+, K1, K2, 3 programabilni releji, 2 programabilna vhoda</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus 5k 230V 100A manual (EN) str. 10-12 (namestitev), 25-26 (tehnični podatki), 149-150 (Appendix A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus/Quattro/Inverter 24-48V 5000VA str. 1; Quick Install Guide MultiPlus 24/48V 5000VA; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_5k/multiplus_quattro_24V_48V_5000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">30</elementInformation>
        <elementInformation name="width" show="1">328</elementInformation>
        <elementInformation name="height" show="1">447</elementInformation>
        <elementInformation name="depth" show="1">241</elementInformation>
    </elementInformations>
