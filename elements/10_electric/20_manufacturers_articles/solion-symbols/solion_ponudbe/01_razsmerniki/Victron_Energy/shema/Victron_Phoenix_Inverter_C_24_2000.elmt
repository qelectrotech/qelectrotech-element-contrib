    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">Phoenix Inverter Compact 24/2000 230V VE.Bus (CIN242200000)</elementInformation>
        <elementInformation name="designation" show="1">Victron Phoenix Inverter C 24/2000</elementInformation>
        <elementInformation name="description" show="1">razsmernik; komunikacija: 2x VE.Bus RJ45 (B), sponke H: temperaturni senzor +/- (po legendi), daljinsko stikalo L (desno+sredina = vklop), programabilni rele P: NO - COM - NC, DIP stikala (M)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Inverter Compact 2000 manual (EN) str. 8-10 (namestitev), 18 (tehnični podatki), 115-116 (Appendix A); Datasheet Phoenix Inverter 1200VA-5000VA str. 2; Dimension drawing Inverter Compact 12/24V 2000VA str. 1; Quick Install Guide Compact Inverter 2000VA; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_phoenix_c_2000/inverter_compact_2000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">12</elementInformation>
        <elementInformation name="width" show="1">252</elementInformation>
        <elementInformation name="height" show="1">524</elementInformation>
        <elementInformation name="depth" show="1">128</elementInformation>
    </elementInformations>
