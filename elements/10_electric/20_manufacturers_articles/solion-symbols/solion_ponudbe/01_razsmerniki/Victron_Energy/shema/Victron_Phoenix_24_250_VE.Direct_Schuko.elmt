        <elementInformation name="manufacturer_reference" show="1">Phoenix Inverter 24/250 230V VE.Direct SCHUKO (PIN241251200)</elementInformation>
        <elementInformation name="designation" show="1">Victron Phoenix 24/250 VE.Direct Schuko</elementInformation>
        <elementInformation name="description" show="1">razsmernik; komunikacija: VE.Direct (VictronConnect prek USB/Bluetooth dongla, GX), daljinski vklop/izklop: 2-polni konektor (levi kontakt je lahko vezan na BAT+, npr. kontakt ključa), sprednje stikalo On / Off / ECO</elementInformation>
        <elementInformation name="notes" show="1">Viri: Inverter VE.Direct 250-1200VA manual (EN) str. 5-6 (namestitev), 9-10 (tehnični podatki), 13-14 (Appendix A, B); Datasheet Inverter VE.Direct 230V (2026) str. 2; Datasheet Inverter VE.Direct 250VA-1600VA (2025) str. 2; Dimension drawing str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_phoenix_vedirect_250_375/inverter_vedirect_250_375VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">2.4</elementInformation>
        <elementInformation name="width" show="1">161</elementInformation>
        <elementInformation name="height" show="1">246</elementInformation>
        <elementInformation name="depth" show="1">84</elementInformation>
