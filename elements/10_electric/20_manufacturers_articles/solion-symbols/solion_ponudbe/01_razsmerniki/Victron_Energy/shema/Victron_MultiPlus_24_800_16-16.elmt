    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus 24/800/16-16 230V VE.Bus (PMP241800000)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus 24/800/16-16</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 1x VE.Bus RJ45 (C); vzporedno/3-fazno prek RJ45 razdelilnika (priročnik 4.4.5), daljinsko stikalo REMOTE ON/Ch/+ (H), temperaturni senzor TEMP -/+ (D, priložen), programabilni rele ALARM COM/NC/NO (E): AC 230 V/4 A, DC 4 A do 35 V, 1 A do 60 V, DIP stikala (A), stikalo On/Off/Charger only (B)</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus 500VA-1200VA manual (EN) str. 9-12 (namestitev), 21 (tehnični podatki), 133-134 (Appendix A); Dimension drawing MultiPlus 800VA str. 1; Datasheet MultiPlus 500VA-2000VA (slika, brez besedila) str. 1-2; Victron produktna stran (podatki SKU: mere, masa, IP) · 3D (STEP): cad/victron_multiplus_800/multiplus_800VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">6.4</elementInformation>
        <elementInformation name="width" show="1">223.9</elementInformation>
        <elementInformation name="height" show="1">351.9</elementInformation>
        <elementInformation name="depth" show="1">100.6</elementInformation>
    </elementInformations>
