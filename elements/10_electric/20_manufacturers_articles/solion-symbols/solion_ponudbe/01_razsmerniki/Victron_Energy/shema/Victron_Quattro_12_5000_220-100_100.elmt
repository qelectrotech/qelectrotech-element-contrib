    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">Quattro 12/5000/220-100/100 230V VE.Bus (QUA125020000)</elementInformation>
        <elementInformation name="designation" show="1">Victron Quattro 12/5000/220-100/100</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (B), daljinsko stikalo H (3-polno), alarmni rele I: NC, NO, COM, sponke E (od leve): V-SENSE, T-SENSE, AUX1, AUX2, GND-relay, TRICKLE+, K1, K2, 3 programabilni releji, 2 programabilna vhoda</elementInformation>
        <elementInformation name="notes" show="1">Viri: Quattro 5k-15k 100/100A 230V manual (EN) str. 12-13 (namestitev), 26 (tehnični podatki), 171 in 173 (Appendix A, 5-10 kVA); Datasheet Quattro 3kVA-15kVA str. 2; Dimension drawing str. 1; Enclosure dimensions wall mounting plate str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_quattro_12_5k/quattro_8kVA_housing_incl_12V5kVA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">34</elementInformation>
        <elementInformation name="width" show="1">348</elementInformation>
        <elementInformation name="height" show="1">467</elementInformation>
        <elementInformation name="depth" show="1">281</elementInformation>
    </elementInformations>
