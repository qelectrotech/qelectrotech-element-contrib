    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus Compact 12/2000/80-30 230V VE.Bus (CMP122200000)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus C 12/2000/80-30</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (B), temperaturni senzor H (+, -), daljinsko stikalo L (desno+sredina = vklop, levo+sredina = samo polnilnik), programabilni rele P: NO - COM - NC (LED S), DIP stikala DS1-DS8 (M)</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus Compact 2000 230V manual (EN) str. 12-15 (namestitev), 26 (tehnični podatki), 135-136 (Appendix A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus Compact 12/24V 2000VA str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_c_2000/multiplus_compact_2000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">12</elementInformation>
        <elementInformation name="width" show="1">252</elementInformation>
        <elementInformation name="height" show="1">524</elementInformation>
        <elementInformation name="depth" show="1">128</elementInformation>
