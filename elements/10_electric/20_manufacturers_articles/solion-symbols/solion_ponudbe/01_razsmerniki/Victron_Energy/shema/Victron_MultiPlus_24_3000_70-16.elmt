<definition version="0.200" type="element" link_type="simple" width="690" height="540" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{dbd00501-9043-5ed5-bd1a-d80560dbe972}" />
    <names>
        <name lang="en">Victron MultiPlus 24/3000/70-16</name>
        <name lang="sl">Victron MultiPlus 24/3000/70-16</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus 24/3000/70-16 230V VE.Bus (PMP242300001)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus 24/3000/70-16</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (B), daljinsko stikalo, 3-polna sponka H (levo+sredina = vklop, desno+sredina = samo polnilnik), alarmni rele I: NC, NO, COM (AC 230 V/4 A; DC 4 A do 35 V, 1 A do 60 V), sponke E (od leve): V-SENSE +/-, AUX vhod 1 +/-, STARTER+, GND-relay +/-, T-SENSE +/-, 1 programabilni rele in 1 analogni/digitalni vhod (16 A model), DIP stikala DS1-DS8 (M), tipki Up/Down (K)</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus 3k 230V 16A/50A manual (EN) str. 10-12 (namestitev), 25 (tehnični podatki), 144 in 146 (Appendix A, 16 A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus/Quattro/Inverter 12-24-48V 3000VA str. 1; Quick Install Guide MultiPlus 3000VA 16A; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_3k_16a/multiplus_quattro_3000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">18</elementInformation>
        <elementInformation name="width" show="1">258</elementInformation>
        <elementInformation name="height" show="1">364</elementInformation>
        <elementInformation name="depth" show="1">221</elementInformation>
    </elementInformations>
    <informations>Viri: MultiPlus 3k 230V 16A/50A manual (EN) str. 10-12 (namestitev), 25 (tehnični podatki), 144 in 146 (Appendix A, 16 A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus/Quattro/Inverter 12-24-48V 3000VA str. 1; Quick Install Guide MultiPlus 3000VA 16A; Victron produktna stran (SKU podatki)
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
