    <names>
        <name lang="en">Victron MultiPlus-II 24/3000/70-32</name>
        <name lang="sl">Victron MultiPlus-II 24/3000/70-32</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus-II 24/3000/70-32 230V (PMP242305010)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus-II 24/3000/70-32</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (L), daljinsko stikalo Remote On/Off (K), kratek stik = vklop, alarmni rele AUX RELAY D: NO, NC, COM, zunanji tokovni senzor M: INT, EXT, COM (mostiček INT-COM), sponke N 1-12: +12V, K1, GND-relay, AUX1, AUX2, T-sense, V-sense, tipka A (zagon brez asistentov, E), stikalo J: 1 = vklop, 0 = izklop, || = samo polnilnik</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus-II 230V manual (EN, rev 14 07/2026) str. 17-19 (namestitev), 31 (tehnični podatki), 35-36 (Appendix A); Datasheet MultiPlus-II inverter/charger str. 2; Dimension drawing MultiPlus-II 24/48V 3kVA str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_ii_24_3k/multiplus_ii_24V_48V_3000VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">19</elementInformation>
        <elementInformation name="width" show="1">275.4</elementInformation>
        <elementInformation name="height" show="1">506</elementInformation>
        <elementInformation name="depth" show="1">147.1</elementInformation>
    </elementInformations>
