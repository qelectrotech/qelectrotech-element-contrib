    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">MultiPlus Compact 12/1600/70-16 230V VE.Bus (CMP121620000)</elementInformation>
        <elementInformation name="designation" show="1">Victron MultiPlus C 12/1600/70-16</elementInformation>
        <elementInformation name="description" show="1">razsmernik-polnilnik; komunikacija: 2x VE.Bus RJ45 (C), daljinsko stikalo H: 1 = samo polnilnik, 2 = sredina (GND), 3 = vklop, temperaturni senzor D: 1 = rdeča (+), 2 = črna (-), programabilni rele E: 1 = NO, 2 = COM, 3 = NC (LED S ob aktivnem releju), DIP stikala (A)</elementInformation>
        <elementInformation name="notes" show="1">Viri: MultiPlus Compact 800/1200/1600 manual (EN) str. 12-14 (namestitev), 22 (2x RJ45), 27 (tehnični podatki), 141-143 (Appendix A); Datasheet MultiPlus 800VA-5kVA str. 2; Dimension drawing MultiPlus Compact 12/24V 1200-1600VA str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_multiplus_c_800_1600/multiplus_compact_1200_1600VA.step</elementInformation>
        <elementInformation name="mass_kg" show="1">10</elementInformation>
        <elementInformation name="width" show="1">214</elementInformation>
        <elementInformation name="height" show="1">375.6</elementInformation>
        <elementInformation name="depth" show="1">110.5</elementInformation>
