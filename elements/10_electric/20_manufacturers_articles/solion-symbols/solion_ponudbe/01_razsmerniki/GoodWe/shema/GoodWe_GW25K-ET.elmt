    <elementInformations>
        <elementInformation name="manufacturer" show="1">GoodWe</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">GW25K-ET</elementInformation>
        <elementInformation name="designation" show="1">GoodWe GW25K-ET</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 3 MPPT, nizov na MPPT [2, 2, 2], U_dc max 1000 V, MPPT [200, 850] V, I max [30, 30, 30] A; baterija [200, 800] V; komunikacija: CAN (BMS1, BMS2), RS485 (METER), RS485 (EMS / polnilnica), CAN/BUS (paralela), DRED / RCR / EnWG 14a, Remote Shutdown / NS (DI), DO (LOAD / SG Ready), DO2/GEN, 12 V napajanje, WiFi + LAN + Bluetooth</elementInformation>
        <elementInformation name="notes" show="1">Viri: GoodWe ET 15-30kW Series Datasheet (Single page 20241203 V2.1) str. 2; GoodWe ET 15-30kW User Manual V2.2 2026-09-15 str. 34-35 (komponente), 127-133 (odklopniki, kabli), 141-146 (BAT1/BAT2, BMS pini), 169-172 (COM)</elementInformation>
        <elementInformation name="mass_kg" show="1">54</elementInformation>
        <elementInformation name="width" show="1">520</elementInformation>
        <elementInformation name="height" show="1">660</elementInformation>
        <elementInformation name="depth" show="1">220</elementInformation>
    </elementInformations>
