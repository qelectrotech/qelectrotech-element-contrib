    <elementInformations>
        <elementInformation name="manufacturer" show="1">GoodWe</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">GW15K-ET-20</elementInformation>
        <elementInformation name="designation" show="1">GoodWe GW15K-ET-20</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 3 MPPT, nizov na MPPT [1, 1, 1], U_dc max 1000 V, MPPT [120, 850] V, I max [16, 16, 16] A; baterija [150, 720] V; komunikacija: CAN (BMS), RS485 (BMS485), RS485 (METER), CT (vgrajen števec), DRED / RCR / EnWG 14a, DI1/RSD, DO1 (LOAD/SG Ready), DO2 (GEN), EN (12 V / omogočitev baterije), PAR1&amp;EMS / PAR2&amp;EMS (CAN, BUS, RS485), LAN (4G opcija) + Bluetooth + WiFi</elementInformation>
        <elementInformation name="notes" show="1">Viri: GoodWe ET G2 Series 6-15kW Datasheet (EN) str. 2; GoodWe ET G2 Datasheet EMEA (lokalna kopija, 20231204 V2.1) str. 2; GoodWe Residential Smart Inverter Solutions User Manual ET G2 6-15K + Lynx F/D, V2.2 2026-09-30 str. 33-34 (komponente), 120-122 (odklopniki, kabli), 129-131 (AC), 158-162 (COM)</elementInformation>
        <elementInformation name="mass_kg" show="1">25</elementInformation>
        <elementInformation name="width" show="1">496</elementInformation>
        <elementInformation name="height" show="1">460</elementInformation>
        <elementInformation name="depth" show="1">221</elementInformation>
    </elementInformations>
