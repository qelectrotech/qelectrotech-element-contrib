    <elementInformations>
        <elementInformation name="manufacturer" show="1">GoodWe</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">GW25K-ETA-G20</elementInformation>
        <elementInformation name="designation" show="1">GoodWe ESA 25 kW GW25K-ETA-G20</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 4 MPPT, nizov na MPPT [1, 1, 2, 2], U_dc max 1000 V, MPPT [120, 950] V, I max [21, 21, 42, 42] A; baterija [700, 950] V; komunikacija: CAN (BMS, interno), RS485 (METER), CT (vgrajen števec), RS485 (EMS / GoodWe polnilnica), PAR1/PAR2 (paralela), STS (RJ45), DRED / RCR / EnWG 14a, DI (Remote/Rapid Shutdown), DO LOAD, DO GEN, WiFi + LAN + Bluetooth, 4G (opcija), Modbus-RTU, Modbus-TCP</elementInformation>
        <elementInformation name="notes" show="1">Viri: GoodWe ESA Series 5-30kW/5-108kWh Datasheet (Single page 20260616 V2.1) str. 2-3; GoodWe ESA (ETA/BTA-G20 + BAT-D-G20 + STS) User Manual V1.5-2026-09-04 str. 2-4 (izdelki), 46-52 (konfiguracija, komponente), 138-146 (odklopniki, kabli, PE), 147-163 (PV, BAT, AC, COM)</elementInformation>
        <elementInformation name="mass_kg" show="1">38</elementInformation>
        <elementInformation name="width" show="1">800</elementInformation>
        <elementInformation name="height" show="1">340</elementInformation>
        <elementInformation name="depth" show="1">270</elementInformation>
    </elementInformations>
