<definition version="0.200" type="element" link_type="simple" width="510" height="550" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{49c69fee-f036-5683-9471-a0b4a1505b6a}" />
    <names>
        <name lang="en">Sigen Hibridni razsmernik 5.0 kW TP</name>
        <name lang="sl">Sigen Hibridni razsmernik 5.0 kW TP</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11010019</elementInformation>
        <elementInformation name="designation" show="1">Sigen Hibridni razsmernik 5.0 kW TP</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 2 MPPT, nizov na MPPT [1, 1], U_dc max 1100 V, MPPT [160, 1000] V, I max [16, 16] A; baterija [600, 900] V; komunikacija: RS485-1 (EMS / števec / TČ, COM 15-16), RS485-2 (Sigen Sensor števec, COM 13-14), 2x RJ45 Fast Ethernet (RJ45 1 / RJ45 2), WLAN 2,4 GHz (antena ANT), 4G Sigen CommMod (vtičnica 4G), 5x DI (DI1-DI4 DRM/RCR, DI5 hitri izklop/NS/EPO), 2x DO suhi kontakt (rezervirano, 12 V / 1 A)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Hybrid (5.0-30.0) TP, Sigenergy str. 2; SigenStor Home Installation Guide - Three-phase System A1, v12 (2026-08-17); iz ZIP SigenStor Home Installer Manual - Three-phase System A1_EN.zip str. 3 (AC stikalo), 6 (Port Descriptions), 8-9 (kabli, M5 OT/DT), 26-30 (AC priključek, L1 L2 L3 N PE), 31 (COM 16-pin), 38 (PV nizi); Sigen Hybrid / SigenStor EC (5.0-30.0) TP Installation Guide (AU), v03 (2025-03-25); iz ZIP 5-30 three phase AU inverter Manual &amp; Declaration Documentation.zip str. 2 (Ports introduction), 4-5 (kabli), 17 (COM 16-pin), 19 (PV nizi); SigenStor EC (5.0-30.0) TP, Sigen Hybrid (5.0-30.0) TP User Manual (AU); iz istega ZIP str. 11 (Port Introduction), 27 (Isc battery port 90 A); Datasheet - SigenStor BAT 6.0/10.0, Sigenergy (tip baterije LiFePO4) str. 2; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu</elementInformation>
        <elementInformation name="mass_kg" show="1">36</elementInformation>
        <elementInformation name="width" show="1">700</elementInformation>
        <elementInformation name="height" show="1">300</elementInformation>
        <elementInformation name="depth" show="1">283</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - Sigen Hybrid (5.0-30.0) TP, Sigenergy str. 2; SigenStor Home Installation Guide - Three-phase System A1, v12 (2026-08-17); iz ZIP SigenStor Home Installer Manual - Three-phase System A1_EN.zip str. 3 (AC stikalo), 6 (Port Descriptions), 8-9 (kabli, M5 OT/DT), 26-30 (AC priključek, L1 L2 L3 N PE), 31 (COM 16-pin), 38 (PV nizi); Sigen Hybrid / SigenStor EC (5.0-30.0) TP Installation Guide (AU), v03 (2025-03-25); iz ZIP 5-30 three phase AU inverter Manual &amp; Declaration Documentation.zip str. 2 (Ports introduction), 4-5 (kabli), 17 (COM 16-pin), 19 (PV nizi); SigenStor EC (5.0-30.0) TP, Sigen Hybrid (5.0-30.0) TP User Manual (AU); iz istega ZIP str. 11 (Port Introduction), 27 (Isc battery port 90 A); Datasheet - SigenStor BAT 6.0/10.0, Sigenergy (tip baterije LiFePO4) str. 2; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
