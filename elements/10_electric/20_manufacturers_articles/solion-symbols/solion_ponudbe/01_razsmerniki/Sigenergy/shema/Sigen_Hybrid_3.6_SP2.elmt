<definition version="0.200" type="element" link_type="simple" width="510" height="730" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{8045bb9b-dfd5-5134-bb8e-71c5306bab04}" />
    <names>
        <name lang="en">Sigen Hybrid 3.6 SP2</name>
        <name lang="sl">Sigen Hybrid 3.6 SP2</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11020006</elementInformation>
        <elementInformation name="designation" show="1">Sigen Hybrid 3.6 SP2</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 2 MPPT, nizov na MPPT [1, 1], U_dc max 600 V, MPPT [50, 550] V, I max [16, 16] A; baterija [300, 600] V; komunikacija: RS485-1 (prosta), RS485-2 (Sigen Sensor SP-DH / SP-CT120-DH), RJ45 BAT (SigenStor BC), 2x FE (RJ45), WLAN (ANT), 4G Sigen CommMod, 5x DI (rezervirano DRM/RCR), 2x DO preklopni (NC/COM/NO, rezervirano), 5 V (rezervirano)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Hybrid Inverter SP2 &amp; TP2 (Version 20260601), Sigenergy str. 2 (levo SP2, desno TP2); Sigen Hybrid (2.0-6.0) SP2 Series Installation Guide, v04 (2026-04-21); iz ZIP Sigen Hybrid (2.0-6.0) SP2 Series Installer Manual_EN.zip str. 2 (Port Introduction, mere), 4 (kabli), 11 (COM), 14 (PV); Sigen Hybrid SP2, TP2 Series and SigenStor Energy User Manual str. 17-18 (AC stikalo), 24-25; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu; SigenStor ESS Installation Guide (Supporting Sigen Hybrid SP2, TP2); iz ZIP SigenStor Energy Storage System Installer Manual (Supporting Sigen Hybrid SP2, TP2 Series Inverters)_EN.zip str. 4 (DC kabel BC-razsmernik Cu 6 mm2, &lt;= 20 m) - prek teh_iz_ponudb</elementInformation>
        <elementInformation name="mass_kg" show="1">11.5</elementInformation>
        <elementInformation name="width" show="1">373</elementInformation>
        <elementInformation name="height" show="1">473</elementInformation>
        <elementInformation name="depth" show="1">99</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - Sigen Hybrid Inverter SP2 &amp; TP2 (Version 20260601), Sigenergy str. 2 (levo SP2, desno TP2); Sigen Hybrid (2.0-6.0) SP2 Series Installation Guide, v04 (2026-04-21); iz ZIP Sigen Hybrid (2.0-6.0) SP2 Series Installer Manual_EN.zip str. 2 (Port Introduction, mere), 4 (kabli), 11 (COM), 14 (PV); Sigen Hybrid SP2, TP2 Series and SigenStor Energy User Manual str. 17-18 (AC stikalo), 24-25; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu; SigenStor ESS Installation Guide (Supporting Sigen Hybrid SP2, TP2); iz ZIP SigenStor Energy Storage System Installer Manual (Supporting Sigen Hybrid SP2, TP2 Series Inverters)_EN.zip str. 4 (DC kabel BC-razsmernik Cu 6 mm2, &lt;= 20 m) - prek teh_iz_ponudb
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
