<definition version="0.200" type="element" link_type="simple" width="510" height="550" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{1ca27b4b-34ee-548e-ba61-2b3b1c08266a}" />
    <names>
        <name lang="en">SigenStor Energy Controller EC 6.0 kW SP</name>
        <name lang="sl">SigenStor Energy Controller EC 6.0 kW SP</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11040001</elementInformation>
        <elementInformation name="designation" show="1">SigenStor Energy Controller EC 6.0 kW SP</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 2 MPPT, nizov na MPPT [1, 1], U_dc max 600 V, MPPT [50, 550] V, I max [16, 16] A; baterija [300, 600] V; komunikacija: RS485-1 (EMS / števec / TČ, COM 15-16), RS485-2 (Sigen Sensor SP-DH / SP-CT120-DH, COM 13-14), 2x RJ45 Fast Ethernet (RJ45 1 / RJ45 2), WLAN 2,4 GHz (ANT), 4G Sigen CommMod, 5x DI (DI1-DI4 DRM/RCR, DI5 hitri izklop/NS/EPO), 2x DO suhi kontakt (rezervirano, 12 V / 1 A)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - SigenStor EC (Sigen Energy Controller 3.0-12.0 SP / 5.0-30.0 TP), Sigenergy str. 1 (SP), 2 (TP); SigenStor Home Installation Guide - Single-phase System (3.0-6.0) A1, v08 (2026-08-17); iz ZIP SigenStor Home Installer Manual - Single-phase System(3.0-6.0) A1_EN.zip str. 3 (AC stikalo), 5 (Port Descriptions), 7 (kabli), 25 (COM 16-pin), 32 (PV nizi); Datasheet - SigenStor BAT 6.0/10.0, Sigenergy (tip baterije LiFePO4) str. 2; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu</elementInformation>
        <elementInformation name="mass_kg" show="1">18</elementInformation>
        <elementInformation name="width" show="1">700</elementInformation>
        <elementInformation name="height" show="1">300</elementInformation>
        <elementInformation name="depth" show="1">245</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - SigenStor EC (Sigen Energy Controller 3.0-12.0 SP / 5.0-30.0 TP), Sigenergy str. 1 (SP), 2 (TP); SigenStor Home Installation Guide - Single-phase System (3.0-6.0) A1, v08 (2026-08-17); iz ZIP SigenStor Home Installer Manual - Single-phase System(3.0-6.0) A1_EN.zip str. 3 (AC stikalo), 5 (Port Descriptions), 7 (kabli), 25 (COM 16-pin), 32 (PV nizi); Datasheet - SigenStor BAT 6.0/10.0, Sigenergy (tip baterije LiFePO4) str. 2; teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
