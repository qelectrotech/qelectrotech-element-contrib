<definition version="0.200" type="element" link_type="simple" width="730" height="570" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{18f5c76e-2674-57a9-93f0-aa9226db44d7}" />
    <names>
        <name lang="en">Sigen Hybrid Inverter 100.0 kW M1 (HYA)</name>
        <name lang="sl">Sigen Hybrid Inverter 100.0 kW M1 (HYA)</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11010134</elementInformation>
        <elementInformation name="designation" show="1">Sigen Hybrid Inverter 100.0 kW M1 (HYA)</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 8 MPPT, nizov na MPPT [2, 2, 2, 2, 2, 2, 2, 2], U_dc max 1100 V, MPPT [160, 1000] V, I max [40, 40, 40, 40, 40, 40, 40, 40] A; baterija [550, 1100] V; komunikacija: RS485-1-1 (COM 15-16), RS485-1-2 rezervirano (COM 3-4), RS485-2 števec (COM 13-14), RJ45 1/2 Fast Ethernet, RJ45 3 SigenStack, WLAN (ANT), 4G Sigen CommMod, 5x DI (DRM/RCR, DI5 NS/EPO), DO1 suhi kontakt (rezervirano)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Hybrid 50/60/80/100/110/125M1 (HYA) (Version 20260709), Sigenergy str. 2; Sigen PV (50-125)M1, Sigen PV (36-110)M1-HYA Series Installation Guide, v08 (2026-08-06) str. 7 (mere), 8-9 (Port Introduction PV / HYA), 11-14 (kabli, Table 2-1), 34 (AC L1 L2 L3 N M12, PE M8), 39-43 (PV konektorji Staubli/Amphenol, razporeditev nizov), 45-46 (COM 16-pin), 55-56 (SigenStack); Datasheet - SigenStack BAT 12.0 &amp; SigenStack BC, Sigenergy str. 2 (550-1100 V, 180 A); C&amp;I Sigen Inverter &amp; Sigen Battery Energy Storage System User Manual (2025-09-08) str. 45 (AC stikalo PV/HYA), 48 (AC stikalo HYB grid/backup); teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu</elementInformation>
        <elementInformation name="mass_kg" show="1">78</elementInformation>
        <elementInformation name="width" show="1">918</elementInformation>
        <elementInformation name="height" show="1">640</elementInformation>
        <elementInformation name="depth" show="1">340</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - Sigen Hybrid 50/60/80/100/110/125M1 (HYA) (Version 20260709), Sigenergy str. 2; Sigen PV (50-125)M1, Sigen PV (36-110)M1-HYA Series Installation Guide, v08 (2026-08-06) str. 7 (mere), 8-9 (Port Introduction PV / HYA), 11-14 (kabli, Table 2-1), 34 (AC L1 L2 L3 N M12, PE M8), 39-43 (PV konektorji Staubli/Amphenol, razporeditev nizov), 45-46 (COM 16-pin), 55-56 (SigenStack); Datasheet - SigenStack BAT 12.0 &amp; SigenStack BC, Sigenergy str. 2 (550-1100 V, 180 A); C&amp;I Sigen Inverter &amp; Sigen Battery Energy Storage System User Manual (2025-09-08) str. 45 (AC stikalo PV/HYA), 48 (AC stikalo HYB grid/backup); teh_iz_ponudb (Generator ponudb SOLION) - obstoječi tehnični zapis s preseki kablov in AC stikali str. polje teh_iz_ponudb pri artiklu
Drawn with terminals2qet 0.2.0 from the terminal table</informations>
