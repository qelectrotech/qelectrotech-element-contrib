    <names>
        <name lang="en">SolarEdge SE7K 7.0 kW 3F</name>
        <name lang="sl">SolarEdge SE7K 7.0 kW 3F</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SLESE7K-RW0TEBEN4</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge SE7K 7.0 kW 3F</elementInformation>
        <elementInformation name="description" show="1">omrežni razsmernik; 1 MPPT, nizov na MPPT [2], U_dc max 900 V, MPPT - V, I max - A; komunikacija: RS485-1 (B, A, G) – 6-polna sponka, RS485-2 (B, A, G) – 6-polna sponka; terminacija DIP SW, Ethernet RJ45 (CAT5/6), USB (servis), SolarEdge Home Network (brezžično, opcijski plug-in), Wi-Fi (opcija, zunanja antena), Cellular (opcija), power reduction (kabel skozi uvodnico 2), SetApp (vgrajena Wi-Fi dostopna točka)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Home Wave Wechselrichter Dreiphasen SE3K–SE10K – Datenblatt DS-000145b-DE (22. 8. 2023), velja za PN SEXXK-XXXTXBXX4 (ime datoteke: SExRW0TEBEN4); kopija uradnega SolarEdge dokumenta (vir: siblik.com) str. 2; SolarEdge Three Phase Inverter SE3K–SE10K (SetApp) – datasheet 02/2020/V01/ENG ROW (starejši); kopija uradnega SolarEdge dokumenta (vir: solarproof.com.au) str. 2; Three Phase System Installation Guide with SetApp Configuration, Europe and APAC, MAN-01-00505-1.4 (junij 2020); kopija uradnega SolarEdge dokumenta (vir: solarshop.baywa-re.lv) str. PDF 22 (vmesniki), 31-33 (AC L1 L2 L3 N PE, 16 mm², navori), 34 (RCD), 44 (kom. uvodnice, RJ45, 6-polna RS485), 50 (RS485-1/RS485-2 B A G), 78 (AC presek, 2 MC4 para); teh_iz_ponudb (skupine/A5_solaredge.json) – vir v zapisu: knowledge-center.solaredge.com se-home-wave-inverter-three-phase-setapp-ds.pdf str. -</elementInformation>
        <elementInformation name="mass_kg" show="1">16.4</elementInformation>
        <elementInformation name="width" show="1">315</elementInformation>
        <elementInformation name="height" show="1">540</elementInformation>
        <elementInformation name="depth" show="1">191</elementInformation>
