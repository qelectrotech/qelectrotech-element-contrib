<definition version="0.200" type="element" link_type="simple" width="490" height="570" hotspot_x="20" hotspot_y="20">
    <uuid uuid="{e48667cf-fa4f-5bec-9a67-3b15c8739b33}" />
    <names>
        <name lang="en">SolarEdge Home Hub SE4000H 4.0 kW 1F</name>
        <name lang="sl">SolarEdge Home Hub SE4000H 4.0 kW 1F</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SLESE4000H-RWBMNBF54</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge Home Hub SE4000H 4.0 kW 1F</elementInformation>
        <elementInformation name="description" show="1">hibridni razsmernik; 1 MPPT, nizov na MPPT [2], U_dc max 480 V, MPPT - V, I max - A; komunikacija: RS485-1 (B, A, G) – števec SolarEdge ali tuji (Modbus); terminacija s stikali, RS485-2 (B, A, G) – veriga leader/follower, vtič 'Backup Interface': 12V +/-, RSD -/+, RS485 G/A/B (do Home Backup Interface), vtič '2nd Inv. / Battery': RSD -/+ (RSD več razsmernikov), Battery G/En/A/B, Ethernet RJ45 (LAN, CAT5e/6), SolarEdge Home Network (vgrajen plug-in + antena; Inline Meter, Smart Energy Hot Water, Home Battery 400V), Wi-Fi (opcijska antena), LTE (opcija), SetApp (vgrajena Wi-Fi dostopna točka)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Home Hub Inverter Single Phase, for Europe – datasheet DS-000198-EU (22. 8. 2023); kopija uradnega SolarEdge dokumenta (vir: portal.segen.co.uk) str. 2; SolarEdge Home Hub-Wechselrichter Einphasig – Datenblatt DS-000198-DE (24. 8. 2023); kopija uradnega SolarEdge dokumenta (vir: vpsolar.com) str. 2; Home Hub Inverter – Single Phase Quick Installation Guide for Europe models SEXXXXH-RWMBNBF54, Rev 1.2 (julij 2023); kopija uradnega SolarEdge dokumenta (vir: cdn.shopify.com) str. 1 (A montaža, B ožičenje AC/PV/baterija, zaščita 28/50 A), 2 (C LAN, D baterija G En A B, E Home Network, F Backup Interface 12V/RSD/RS485, G več razsmernikov RS485-2, H števec RS485-1 in RSD); Home Hub Inverter – Single Phase Quick Installation Guide For Europe (marec 2023); kopija uradnega SolarEdge dokumenta (vir: portal.segen.co.uk) str. 1 (masa 12,6 kg na sliki montaže), 2; teh_iz_ponudb (skupine/A5_solaredge.json) – vir v zapisu: goodenergy.co.uk SolarEdge-inverter-datasheet.pdf; vrednosti tokov/napetosti potrjene z DS-000198-EU str. -</elementInformation>
        <elementInformation name="mass_kg" show="1">12</elementInformation>
        <elementInformation name="width" show="1">370</elementInformation>
        <elementInformation name="height" show="1">459</elementInformation>
        <elementInformation name="depth" show="1">154</elementInformation>
    </elementInformations>
