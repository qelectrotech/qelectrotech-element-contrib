    <names>
        <name lang="en">SolarEdge SE17K 17.0 kW 3F</name>
        <name lang="sl">SolarEdge SE17K 17.0 kW 3F</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SLESE17K-RW0T0BNN4</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge SE17K 17.0 kW 3F</elementInformation>
        <elementInformation name="description" show="1">omrežni razsmernik; 1 MPPT, nizov na MPPT [2], U_dc max 1000 V, MPPT - V, I max - A; komunikacija: RS485-1 (B, A, G) – 6-polna sponka, RS485-2 (B, A, G) – 6-polna sponka; terminacija DIP SW, Ethernet RJ45 (CAT5/6), USB (servis), Wi-Fi (opcija, dodatna komponenta), Cellular (opcija), RS485 prenapetostna zaščita – opcijski SPD plug-in, power reduction (kabel skozi uvodnico 2), SetApp (vgrajena Wi-Fi dostopna točka)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Three Phase Inverter For Europe SE12.5K–SE20K – datasheet DS-000040-3.2-EU (07/2021); kopija uradnega SolarEdge dokumenta (vir: shop.solexis.ch) str. 2; SolarEdge Three Phase Inverter SE12.5K–SE27.6K (SetApp) – datasheet 12/2018/V02/ENG ROW (starejši); kopija uradnega SolarEdge dokumenta (vir: midsummer.ie) str. 2; Three Phase System Installation Guide with SetApp Configuration, Europe and APAC, MAN-01-00505-1.4 (junij 2020); kopija uradnega SolarEdge dokumenta (vir: solarshop.baywa-re.lv) str. PDF 22 (vmesniki), 31-33 (AC sponke), 34 (RCD), 44 (kom. priključki), 50 (RS485-1/-2), 57 (risba mer), 74 (tabela odklopnikov), 78-83 (tehnični podatki); teh_iz_ponudb (skupine/A5_solaredge.json) – vir v zapisu: knowledge-center.solaredge.com se-three-phase-inverter-setapp-datasheet.pdf str. -</elementInformation>
        <elementInformation name="mass_kg" show="1">30.7</elementInformation>
        <elementInformation name="width" show="1">317</elementInformation>
        <elementInformation name="height" show="1">549</elementInformation>
        <elementInformation name="depth" show="1">264</elementInformation>
    </elementInformations>
