    <names>
        <name lang="en">Victron SmartSolar MPPT 150/85-Tr VE.Can</name>
        <name lang="sl">Victron SmartSolar MPPT 150/85-Tr VE.Can</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Victron Energy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">SmartSolar MPPT 150/85-Tr VE.Can (SCC115085411)</elementInformation>
        <elementInformation name="designation" show="1">Victron SmartSolar MPPT 150/85-Tr VE.Can</elementInformation>
        <elementInformation name="description" show="1">MPPT regulator; 1 MPPT, nizov na MPPT [1], U_dc max 150 (abs.), 145 zagon/obratovanje V, MPPT - V, I max - A; komunikacija: VE.Direct, 2x VE.Can RJ45 (do 25 naprav, sinhrono polnjenje; +V vezan na BAT+, -V na BAT- in PV-; ni galvansko ločen), Bluetooth Smart, remote on/off L/H (2-polni konektor), programabilni rele NO/C/NC (DPST; AC 240 V/4 A, DC 4 A do 35 V, 1 A do 60 V)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SmartSolar MPPT 150/70 up to 250/100 VE.Can manual (EN) str. 8, 11, 13, 15, 17-19, 31; Datasheet SmartSolar MPPT 150/70 up to 150/100 VE.Can str. 2; Datasheet SmartSolar MPPT 250/70 up to 250/100 VE.Can str. 2; Dimension drawing Tr VE.Can (XL) str. 1; Victron produktna stran (SKU podatki) · 3D (STEP): cad/victron_smartsolar_vecan_tr_85_100/mppt_vecan_tr_XL.step</elementInformation>
        <elementInformation name="mass_kg" show="1">4.5</elementInformation>
        <elementInformation name="width" show="1">295</elementInformation>
        <elementInformation name="height" show="1">216</elementInformation>
        <elementInformation name="depth" show="1">103</elementInformation>
