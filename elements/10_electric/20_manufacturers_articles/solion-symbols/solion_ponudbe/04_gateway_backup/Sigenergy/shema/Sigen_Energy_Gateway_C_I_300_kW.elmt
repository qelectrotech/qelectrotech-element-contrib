    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11110010</elementInformation>
        <elementInformation name="designation" show="1">Sigen Energy Gateway C&amp;I 300 kW</elementInformation>
        <elementInformation name="description" show="1">gateway/backup; komunikacija: 2x FE (RJ45), RS485 (rezervirano), DI1 (bypass), DI2 (ATS), DO1 (omrežni kontaktor), DO2 (kontaktor agregata), DO3 (2-žilni zagon agregata)</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Energy Gateway (for SigenStor) C60-2 / C120-6 / C180-9 / C300-12 / C600 / C1200, Sigenergy str. 2; Sigen Gateway (C180-9, C300-12, C300-B) Installation Guide (besedilo s posebnim kodiranjem pisave - brano s slik) str. 2 (mere, Top view), 3 (notranjost QF/KM/QS), 11-14 (priključki, komunikacija); Sigen Energy Gateway C&amp;I Series User Manual, v08 (2026-08-24) str. 24-26 (C60-2), 30-32 (C120-6), 33-35 (C180-9/C300-12), 36-45 (C600/C1200/-B); Application Note - How to connect the Generator to Sigen Energy Gateway</elementInformation>
        <elementInformation name="mass_kg" show="1">400</elementInformation>
        <elementInformation name="width" show="1">800</elementInformation>
        <elementInformation name="height" show="1">2300</elementInformation>
        <elementInformation name="depth" show="1">830</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - Sigen Energy Gateway (for SigenStor) C60-2 / C120-6 / C180-9 / C300-12 / C600 / C1200, Sigenergy str. 2; Sigen Gateway (C180-9, C300-12, C300-B) Installation Guide (besedilo s posebnim kodiranjem pisave - brano s slik) str. 2 (mere, Top view), 3 (notranjost QF/KM/QS), 11-14 (priključki, komunikacija); Sigen Energy Gateway C&amp;I Series User Manual, v08 (2026-08-24) str. 24-26 (C60-2), 30-32 (C120-6), 33-35 (C180-9/C300-12), 36-45 (C600/C1200/-B); Application Note - How to connect the Generator to Sigen Energy Gateway
