    <elementInformations>
        <elementInformation name="manufacturer" show="1">Sigenergy</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">11110054</elementInformation>
        <elementInformation name="designation" show="1">Sigen Gateway C1200-B</elementInformation>
        <elementInformation name="description" show="1">gateway/backup; komunikacija: 2x FE (RJ45, J5/J6), RS485 P6 (rezervirano), DI1 zasilni izklop, DI2/DI3 ATS (P8), DO1/DO2/DO3 preklopni (P10), DO3 = 2-žilni zagon agregata</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Energy Gateway for Sigen C&amp;I Inverter C600-B / C1200-B (Preliminary), Sigenergy str. 2; Sigen Gateway (C600, C1200, C600-B, C1200-B) Installation Guide, v04 (2025-11-28) str. 2 (mere, Top/Bottom view), 3-4 (notranjost QA/SA/2QF), 6-7 (kabli), 24-25 (INV L1 L2 L3 N PE), 26-27 (P6/J5/J6/P10/P8), 29 (ACB nastavitve); Sigen Energy Gateway C&amp;I Series User Manual, v08 (2026-08-24) str. 24-26 (C60-2), 30-32 (C120-6), 33-35 (C180-9/C300-12), 36-45 (C600/C1200/-B); Application Note - How to connect the Generator to Sigen Energy Gateway</elementInformation>
        <elementInformation name="mass_kg" show="1">1300</elementInformation>
        <elementInformation name="width" show="1">1800</elementInformation>
        <elementInformation name="height" show="1">2300</elementInformation>
        <elementInformation name="depth" show="1">1270</elementInformation>
    </elementInformations>
