        <elementInformation name="designation" show="1">Sigen Gateway C60-2</elementInformation>
        <elementInformation name="description" show="1">gateway/backup; komunikacija: 2x FE (RJ45, J5/J6), RS485 P6 (rezervirano), DI1 zasilni izklop, DI2/DI3 ATS (P8), DO1/DO2/DO3 preklopni (P10), DO3 = 2-žilni zagon agregata</elementInformation>
        <elementInformation name="notes" show="1">Viri: Datasheet - Sigen Energy Gateway (for SigenStor) C60-2 / C120-6 / C180-9 / C300-12 / C600 / C1200, Sigenergy str. 2; Sigen Gateway C60-2 Installation Guide, v02 (2025-09-21) str. 2 (Port Description), 3 (notranjost), 5 (kabli), 13 (L1 L2 L3 N PE), 14-15 (P6/J5/J6/P10/P8); Sigen Energy Gateway C&amp;I Series User Manual, v08 (2026-08-24) str. 24-26 (C60-2), 30-32 (C120-6), 33-35 (C180-9/C300-12), 36-45 (C600/C1200/-B); Application Note - How to connect the Generator to Sigen Energy Gateway</elementInformation>
        <elementInformation name="mass_kg" show="1">35</elementInformation>
        <elementInformation name="width" show="1">510</elementInformation>
        <elementInformation name="height" show="1">795</elementInformation>
        <elementInformation name="depth" show="1">173</elementInformation>
    </elementInformations>
    <informations>Viri: Datasheet - Sigen Energy Gateway (for SigenStor) C60-2 / C120-6 / C180-9 / C300-12 / C600 / C1200, Sigenergy str. 2; Sigen Gateway C60-2 Installation Guide, v02 (2025-09-21) str. 2 (Port Description), 3 (notranjost), 5 (kabli), 13 (L1 L2 L3 N PE), 14-15 (P6/J5/J6/P10/P8); Sigen Energy Gateway C&amp;I Series User Manual, v08 (2026-08-24) str. 24-26 (C60-2), 30-32 (C120-6), 33-35 (C180-9/C300-12), 36-45 (C600/C1200/-B); Application Note - How to connect the Generator to Sigen Energy Gateway
