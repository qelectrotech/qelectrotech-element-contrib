    <uuid uuid="{35525f34-7dd2-5b70-8422-9709c63fb53c}" />
    <names>
        <name lang="en">SolarEdge Backup Box</name>
        <name lang="sl">SolarEdge Backup Box</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">SolarEdge</elementInformation>
        <elementInformation name="manufacturer_reference" show="1">BI-NEUNU-3P-01</elementInformation>
        <elementInformation name="designation" show="1">SolarEdge Backup Box</elementInformation>
        <elementInformation name="description" show="1">gateway/backup; komunikacija: RS485 (1 komunikacijski vhod, do razsmernika RS485-1, CAT5e/CAT6), SolarEdge Home Network (brezžično, v pričakovanju podpore FW), Vgrajen števec uvoz/izvoz 1,25 % (v pričakovanju podpore FW)</elementInformation>
        <elementInformation name="notes" show="1">Viri: SolarEdge Home Backup Interface, Three Phase, for Europe BI-EU3P - datasheet (EN), DS-000142-EU, 30. 3. 2023; kopija uradnega SolarEdge dokumenta (vir: res.cloudinary.com/gpceurope) str. 2; (lokalna kopija) DS-000142-EU 2023 str. 2; SolarEdge Home Backup-Interface, dreiphasig BI-EU3P - Datenblatt (DE), DS-000142, 18. 4. 2022; kopija uradnega SolarEdge dokumenta (vir: portal.segen.co.uk) str. 2; SolarEdge Home Backup Interface, Three Phase BI-EU3P - Quick Installation Guide v1.6, januar 2025, MAN-01-00988-1.6; kopija uradnega SolarEdge dokumenta (vir: solarhandel24.de) str. 1 (Main connection scheme, Bottom interface, montaža), 2 (Grid/Load connection, Connecting the Backup Interface - G, A, B, 12V +/-, LED); SolarEdge Home Backup Interface, Three Phase - Quick Installation Guide v1.2, junij 2023; kopija uradnega SolarEdge dokumenta (vir: cdn.estg.eu) str. 1-2 (barve žil L1 rjava, L2 črna, L3 siva, N modra; RS485 opcijsko ob Home Network); Siblik - Datenblatt BI-NEUNU3P-01 (prodajalec, samo mere/IP/material ohišja), 24. 10. 2024 str. 1</elementInformation>
        <elementInformation name="mass_kg" show="1">5</elementInformation>
        <elementInformation name="width" show="1">238</elementInformation>
        <elementInformation name="height" show="1">390</elementInformation>
        <elementInformation name="depth" show="1">147</elementInformation>
    </elementInformations>
